        "title": {
          "type": "text",
          "label": "Name der Website",
          "validation": {
            "isRequired": true
          }
        },
        "subtitle": {
          "type": "object",
          "label": "Untertitel",
          "layout": [
            6,
            6
          ],
          "fields": {
            "de": {
              "type": "text",
              "label": "Deutsch"
            },
            "en": {
              "type": "text",
              "label": "English"
            }
          }
        },
        "contactEmail": {
          "type": "text",
          "label": "Empfänger Kontaktformular",
          "description": "Wirkt nach dem nächsten Veröffentlichen.",
          "validation": {
            "isRequired": true,
            "pattern": {
              "regex": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
              "message": "Bitte eine E-Mail-Adresse eingeben."
            }
          }
        }
      }
