{
  "site": {
    "root": "site",
    "framework": "astro",
    "schema": "site/cntmgmt.schema.json",
    "productionUrl": "https://circlefly.de",
    "deploy": {
      "signal": {
        "type": "check",
        "name": "deploy-site"
      }
    },
    "preview": {
      "mode": "branch",
      "urlPattern": "https://{branch}.cntmgmt-sandbox.invalid",
      "signal": {
        "type": "status",
        "context": "cntmgmt/preview"
      }
    }
  },
  "ui": {
    "navigation": [
      {
        "label": "Inhalte",
        "items": [
          "news",
          "series"
        ]
      },
      {
        "label": "Seiten",
        "items": [
          "home",
          "gallery",
          "vita",
          "contact",
          "newsletter",
          "impressum",
          "special"
        ]
      },
      {
        "label": "Einstellungen",
        "items": [
          "settings"
        ]
      }
    ]
  },
  "i18n": {
    "locales": [
      {
        "code": "de",
        "label": "Deutsch"
      },
      {
        "code": "en",
        "label": "English"
      }
    ],
    "default": "de",
    "originalField": "lang",
    "statusField": "translation",
    "markOutdatedOnChange": true
  },
  "media": {
    "path": "site/public/media",
    "publicUrl": "/media",
    "allowedTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/heic",
      "application/pdf"
    ],
    "maxFileSize": 31457280,
    "image": {
      "maxEdge": 2400,
      "format": "image/jpeg",
      "quality": 0.85,
      "stripMetadata": true
    },
    "filename": "{slug(name)}.{ext}"
  },
  "collections": [
    {
      "name": "news",
      "label": "Aktuelles",
      "labelSingular": "Beitrag",
      "path": "site/src/content/news",
      "format": "yaml",
      "source": "manual",
      "filename": "{date}-{slug(title)}",
      "create": {
        "defaults": {
          "date": {
            "kind": "today"
          }
        }
      },
      "list": {
        "title": "title",
        "subtitle": "date",
        "thumbnail": "images.0.src",
        "sort": "-date",
        "groupBy": "year(date)",
        "search": [
          "title",
          "body"
        ],
        "badges": [
          "translation"
        ],
        "filters": [
          {
            "label": "Übersetzung prüfen",
            "where": {
              "translation": [
                "machine",
                "outdated"
              ]
            }
          }
        ]
      },
      "preview": {
        "path": "/news/{slug}/",
        "locales": {
          "en": "/en/news/{slug}/"
        }
      },
      "schema": {
        "title": {
          "type": "object",
          "label": "Titel",
          "layout": [
            6,
            6
          ],
          "fields": {
            "de": {
              "type": "text",
              "label": "Deutsch"
            },
            "en": {
              "type": "text",
              "label": "English"
            }
          },
          "description": "Pflicht in der Originalsprache."
        },
        "date": {
          "type": "date",
          "label": "Datum",
          "description": "Wird angezeigt und bestimmt die Reihenfolge.",
          "validation": {
            "isRequired": true
          }
        },
        "lang": {
          "type": "select",
          "label": "Originalsprache",
          "description": "In welcher Sprache der Text ursprünglich geschrieben ist.",
          "options": [
            {
              "label": "Deutsch",
              "value": "de"
            },
            {
              "label": "Englisch",
              "value": "en"
            }
          ],
          "defaultValue": "de"
        },
        "translation": {
          "type": "select",
          "label": "Übersetzung",
          "description": "Stand der Übersetzung in die andere Sprache.",
          "options": [
            {
              "label": "keine",
              "value": "none"
            },
            {
              "label": "maschinell – bitte prüfen",
              "value": "machine"
            },
            {
              "label": "geprüft",
              "value": "reviewed"
            },
            {
              "label": "veraltet",
              "value": "outdated"
            }
          ],
          "defaultValue": "none"
        },
        "images": {
          "type": "array",
          "label": "Bilder",
          "description": "Das erste Bild ist der Flyer.",
          "validation": {
            "length": {
              "max": 12
            }
          },
          "element": {
            "type": "object",
            "label": "Bild",
            "fields": {
              "src": {
                "type": "image",
                "label": "Bild",
                "storage": "string",
                "directory": "site/public/media/news",
                "description": "Adresse wie /media/news/2025/flyer.jpg. Die Medienauswahl speichert heute noch den Repo-Pfad (site/public/…); bitte im Reiter „URL“ /media/… eintragen.",
                "validation": {
                  "isRequired": true
                }
              },
              "title": {
                "type": "text",
                "label": "Bildtitel"
              },
              "caption": {
                "type": "object",
                "label": "Bildunterschrift",
                "layout": [
                  6,
                  6
                ],
                "fields": {
                  "de": {
                    "type": "text",
                    "label": "Deutsch",
                    "multiline": true
                  },
                  "en": {
                    "type": "text",
                    "label": "English",
                    "multiline": true
                  }
                }
              }
            }
          }
        },
        "body": {
          "type": "object",
          "label": "Text",
          "layout": [
            6,
            6
          ],
          "fields": {
            "de": {
              "type": "markdown",
              "label": "Deutsch"
            },
            "en": {
              "type": "markdown",
              "label": "English"
            }
          }
        }
      }
    },
    {
      "name": "series",
      "label": "Werkreihen",
      "labelSingular": "Werkreihe",
      "path": "site/src/content/series",
      "format": "yaml",
      "source": "manual",
      "filename": "{slug(title)}",
      "create": {
        "defaults": {
          "order": 0
        }
      },
      "list": {
        "title": "title",
        "thumbnail": [
          "cover",
          "works.0.src"
        ],
        "subtitle": "count(works)",
        "sort": "order"
      },
      "preview": {
        "path": "/gallery/{slug}/",
        "locales": {
          "en": "/en/gallery/{slug}/"
        }
      },
      "schema": {
        "title": {
          "type": "object",
          "label": "Titel",
          "layout": [
            6,
            6
          ],
          "fields": {
            "de": {
              "type": "text",
              "label": "Deutsch"
            },
            "en": {
              "type": "text",
              "label": "English"
            }
          },
          "description": "Pflicht in der Originalsprache."
        },
        "order": {
          "type": "integer",
          "label": "Reihenfolge",
          "description": "Kleinere Zahl = weiter oben in der Galerie.",
          "validation": {
            "isRequired": true
          }
        },
        "lang": {
          "type": "select",
          "label": "Originalsprache",
          "description": "In welcher Sprache der Text ursprünglich geschrieben ist.",
          "options": [
            {
              "label": "Deutsch",
              "value": "de"
            },
            {
              "label": "Englisch",
              "value": "en"
            }
          ],
          "defaultValue": "de"
        },
        "translation": {
          "type": "select",
          "label": "Übersetzung",
          "description": "Stand der Übersetzung in die andere Sprache.",
          "options": [
            {
              "label": "keine",
              "value": "none"
            },
            {
              "label": "maschinell – bitte prüfen",
              "value": "machine"
            },
            {
              "label": "geprüft",
              "value": "reviewed"
            },
            {
              "label": "veraltet",
              "value": "outdated"
            }
          ],
          "defaultValue": "none"
        },
        "description": {
          "type": "object",
          "label": "Beschreibung",
          "layout": [
            6,
            6
          ],
          "fields": {
            "de": {
              "type": "markdown",
              "label": "Deutsch"
            },
            "en": {
              "type": "markdown",
              "label": "English"
            }
          }
        },
        "cover": {
          "type": "image",
          "label": "Titelbild (optional)",
          "storage": "string",
          "directory": "site/public/media/gallery",
          "description": "Adresse wie /media/news/2025/flyer.jpg. Die Medienauswahl speichert heute noch den Repo-Pfad (site/public/…); bitte im Reiter „URL“ /media/… eintragen."
        },
        "works": {
          "type": "array",
          "label": "Werke",
          "description": "Reihenfolge per Ziehen. Die Adresse eines Werks (slug) bleibt erhalten und wird hier nicht angezeigt.",
          "validation": {
            "length": {
              "min": 1
            }
          },
          "element": {
            "type": "object",
            "label": "Werk",
            "fields": {
              "src": {
                "type": "image",
                "label": "Bild",
                "storage": "string",
                "directory": "site/public/media/gallery",
                "description": "Adresse wie /media/news/2025/flyer.jpg. Die Medienauswahl speichert heute noch den Repo-Pfad (site/public/…); bitte im Reiter „URL“ /media/… eintragen.",
                "validation": {
                  "isRequired": true
                }
              },
              "title": {
                "type": "text",
                "label": "Werktitel"
              },
              "caption": {
                "type": "object",
                "label": "Angaben (Technik, Maße, Jahr)",
                "layout": [
                  6,
                  6
                ],
                "fields": {
                  "de": {
                    "type": "text",
                    "label": "Deutsch",
                    "multiline": true
                  },
                  "en": {
                    "type": "text",
                    "label": "English",
                    "multiline": true
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
